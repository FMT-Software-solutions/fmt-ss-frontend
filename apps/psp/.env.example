# These live in the MONOREPO ROOT .env / .env.local (vite envDir is '../../'),
# and are set in Netlify's environment for the deployed site.
#
# They point at the PRINT-CALC-PRO Supabase project, NOT the fmt-ss one the
# marketing site uses — attendance data lives with the desktop app.
#
# The anon key is safe in a public bundle: this app can only reach five
# SECURITY DEFINER functions, and has no table access whatsoever.
VITE_PSP_SUPABASE_URL=https://<print-calc-pro-ref>.supabase.co
VITE_PSP_SUPABASE_ANON_KEY=<print-calc-pro anon key>
